# ─────────────────────────────────────────────────────────────
# NotebookLM-LLM 環境変数のひな型。.env にコピーして埋める。
# .env は .gitignore 済み。Cookie/トークンは git・チャットに絶対貼らない。
# ─────────────────────────────────────────────────────────────

# --- GitHub（Issue 連絡板）---
GITHUB_REPO=takahashi919/NotebookLM-LLM-
RESEARCH_BRANCH=claude/relaxed-hawking-jjg77v
# gh CLI で認証する場合は GITHUB_TOKEN 不要（gh auth login 済み前提）

# --- NotebookLM ---
# profile 名（~/.notebooklm-mcp-cli/profiles/<NLM_PROFILE>/auth.json）
NLM_PROFILE=default
# Discover Sources(deep) の完了待ち上限（秒）
RESEARCH_TIMEOUT=300

# --- ローカル常駐ワーカー（Surface 常駐運用 / scripts/nlm_worker_daemon.sh）---
# 既存ワーカーを回すポーリング間隔（秒）。フルローカル運用時に使う。
POLL_INTERVAL=120

# --- リモートブラウザ（Cookie 更新時のスマホログイン用）---
# ※ フルローカル運用（Surface 常駐 + ローカル nlm login）なら不要。none のままでよい。
# none | browserbase | novnc | manual
NLM_REMOTE_PROVIDER=manual
# ホスト型（例: browserbase）を使う場合のキー類
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# ログイン待ちの上限(秒)。Free枠の1セッション上限(15分=900s)未満にすること
BB_LOGIN_TIMEOUT=600
# 自前 noVNC を使う場合の接続情報
NOVNC_URL=

# --- チャット層（未実装・Discord 流用時）---
DISCORD_TOKEN=
RUKA_CHANNEL_ID=
# 受け答え・ディスパッチ用の安価モデル
CHAT_MODEL=claude-sonnet-4-6

# --- Phase 4: 各生成AI API（将来）---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
