# ── 認証は git・クラウド・チャットに一歩も載せない ──────────────
# NotebookLM の Cookie / 認証実体（profile）
.notebooklm-mcp-cli/
**/.notebooklm-mcp-cli/
*cookies*.json
*cookies*.txt
*auth.json
*_auth.json
auth.json

# 環境変数（API キー・トークン）
.env
.env.*
!.env.example

# ログ
logs/
**/logs/
*.log

# Python / uv
__pycache__/
*.pyc
.venv/
venv/

# OS / エディタ
.DS_Store
*.swp
.idea/
.vscode/

# ── Obsidian Vault（端末固有の状態は同期しない）──────────────
# 各PC/スマホで中身が違うファイル。これを同期すると競合の原因になる
vault/.obsidian/workspace.json
vault/.obsidian/workspace-mobile.json
vault/.obsidian/workspace.json.bak
vault/.obsidian/cache
vault/.obsidian/.DS_Store
# ゴミ箱・添付の一時物
vault/.trash/
